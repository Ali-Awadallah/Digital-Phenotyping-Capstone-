# Out-of-box local defaults (fresh clone should work immediately)
DATABASE_USER=aware_user
DATABASE_PASSWORD=password
DATABASE_PASSWORD_FILE=
SIGNATURE_DB_USER=aware_user
SIGNATURE_DB_PASSWORD=password
DATA_ENCRYPTION_KEY_B64=REPLACE_WITH_BASE64_32_BYTE_KEY
DATA_ENCRYPTION_KEY_B64_FILE=
# Keep blank for local dev (no key required for ingest/admin API key mode)
API_KEY_INGEST=
API_KEY_ADMIN=
API_KEY_INGEST_FILE=
API_KEY_ADMIN_FILE=
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=capstone
APP_DOCTOR_USERNAME=doctor
APP_DOCTOR_PASSWORD=Doctor@12345
APP_ADMIN_PASSWORD_FILE=
AUTH_SESSION_TTL_HOURS=12
AUTH_ATTEMPT_WINDOW_MINUTES=15
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA_CERT_PATH=
DATABASE_SSL_CLIENT_KEY_PATH=
DATABASE_SSL_CLIENT_CERT_PATH=
