# Use official Python image
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Copy requirements and AI script
COPY accel_ai_service.py .
COPY ai_model_super_advanced.py .

# Install dependencies
RUN pip install --no-cache-dir pandas numpy scikit-learn plotly matplotlib mysql-connector-python

# Run AI service
CMD ["python", "accel_ai_service.py"]